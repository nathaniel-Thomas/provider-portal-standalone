# Environment Configuration for Rayshine Provider Portal

# Development Settings
NODE_ENV=development
PORT=3009

# Database Configuration
# For local development, SQLite is used by default
# For production, configure PostgreSQL or your preferred database
DATABASE_URL=

# Authentication (Optional - Supabase)
# If you want to enable authentication, configure these:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Payment Processing (Optional - Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# API Keys (Optional)
# Add any third-party API keys your app might need
GOOGLE_MAPS_API_KEY=
TWILIO_API_KEY=

# Production Settings
# Only needed when deploying to production
ALLOWED_ORIGINS=http://localhost:3009,http://localhost:3000